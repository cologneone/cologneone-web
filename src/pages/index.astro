---
// Startseite
// Version: 1.4.0
// Historie:
//   1.2.0 (2026-08-18) — Fahrzeuggrafik vorerst wieder entfernt
//   1.3.0 (2026-08-18) — Seitentitel und Beschreibung sagen jetzt, worum
//                        es hier geht — vorher stand da nur "cologneone"
//   1.4.0 (2026-08-24) — Notizen mit auf die Startseite
import Base from '../layouts/Base.astro';

const projektDateien = import.meta.glob('./projekte/*.md', { eager: true });
const projekte = Object.values(projektDateien)
  .map((eintrag) => ({ ...eintrag.frontmatter, url: eintrag.url }))
  .sort((a, b) => String(b.stand).localeCompare(String(a.stand)))
  .slice(0, 4);

const notizDateien = import.meta.glob('./notizen/*.md', { eager: true });
const notizen = Object.values(notizDateien)
  .map((eintrag) => ({ ...eintrag.frontmatter, url: eintrag.url }))
  .sort((a, b) => String(b.stand).localeCompare(String(a.stand)))
  .slice(0, 5);
---

<Base
  metaTitle="cologneone — Wohnmobil-Elektrik, Victron und Sensorik"
  description="Projekte rund um Wohnmobil-Elektrik, Victron-Energiesysteme, Bluetooth-Sensorik und Smart Home — mit Verkabelung, Messwerten, Fallstricken und fertigem Code."
>
  <section class="hero">
    <p class="eyebrow">cologneone.de</p>
    <h1>Basteln, messen, dokumentieren.</h1>
    <p class="lead">
      Hier sammle ich meine Projekte rund um Wohnmobil-Elektrik, Victron-Energiesysteme,
      Sensorik und Smart Home — mit dem Kram, den ich selbst gern gefunden hätte, als ich
      angefangen habe: Verkabelung, Fallstricke, Messwerte, fertiger Code.
    </p>
  </section>

  <h2>Aktuelle Projekte</h2>
  <ul class="cards">
    {projekte.map((projekt) => (
      <li class="card">
        <p class="meta">
          <span class={`tag status-${projekt.status?.toLowerCase()}`}>{projekt.status}</span>
          {projekt.stand && <span>{projekt.stand}</span>}
        </p>
        <h3><a href={projekt.url}>{projekt.titel}</a></h3>
        <p>{projekt.kurz}</p>
      </li>
    ))}
  </ul>

  <p><a href="/projekte">Alle Projekte ansehen →</a></p>

  <h2>Kurz notiert</h2>
  <p class="lead">
    Einzelne Erkenntnisse, für die eine ganze Projektseite zu viel wäre.
  </p>
  <ul class="notizen">
    {notizen.map((notiz) => (
      <li>
        <a href={notiz.url}>{notiz.titel}</a>
        <p>{notiz.kurz}</p>
      </li>
    ))}
  </ul>

  <p><a href="/notizen">Alle Notizen ansehen →</a></p>
</Base>
