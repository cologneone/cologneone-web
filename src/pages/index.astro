---
// Startseite
// Version: 1.5.0
// Historie:
//   1.2.0 (2026-08-18) — Fahrzeuggrafik vorerst wieder entfernt
//   1.3.0 (2026-08-18) — Seitentitel und Beschreibung sagen jetzt, worum
//                        es hier geht — vorher stand da nur "cologneone"
//   1.4.0 (2026-08-24) — Notizen mit auf die Startseite
//   1.5.0 (2026-08-24) — Fahrzeuggrafik im Titelbereich
//   1.6.0 (2026-08-24) — neue Ueberschrift; die alte war eine Aufzaehlung
//                        und sagte nichts
//   1.7.0 (2026-08-24) — Ueberschrift noch einmal: weniger technisch, dafuer
//                        das, worum es wirklich geht — ein altes Fahrzeug mit
//                        neuer Technik
//   1.8.0 (2026-08-24) — Fahrzeug beim Namen nennen: Flair 6000, Baujahr 1998.
//                        Darum geht es auf der ganzen Seite
//   1.9.0 (2026-08-24) — ein Foto des Fahrzeugs als ruhiges Band zwischen
//                        Projekten und Notizen, dazu als Vorschaubild
//   1.10.0 (2026-08-24) — fuers Band die Seitenansicht am Meer statt der
//                         Bergaufnahme: schoenerer Hintergrund, und sie passt
//                         zur Fahrzeuggrafik im Titelbereich
import Base from '../layouts/Base.astro';

const projektDateien = import.meta.glob('./projekte/*.md', { eager: true });
const projekte = Object.values(projektDateien)
  .map((eintrag) => ({ ...eintrag.frontmatter, url: eintrag.url }))
  .sort((a, b) => String(b.stand).localeCompare(String(a.stand)))
  .slice(0, 4);

const notizDateien = import.meta.glob('./notizen/*.md', { eager: true });
const notizen = Object.values(notizDateien)
  .map((eintrag) => ({ ...eintrag.frontmatter, url: eintrag.url }))
  .sort((a, b) => String(b.stand).localeCompare(String(a.stand)))
  .slice(0, 5);
---

<Base
  metaTitle="cologneone — ein Flair 6000 von 1998 mit Victron, Sensorik und Node-RED"
  bild="/bilder/flair-band.jpg"
  description="Ein Niesmann+Bischoff Flair 6000 von 1998, nachgerüstet mit Victron-Energiesystem, Bluetooth-Sensorik und Node-RED — mit Verkabelung, Messwerten, Fallstricken und fertigem Code."
>
  <section class="hero">
    <p class="eyebrow">cologneone.de</p>
    <h1>Ein Flair 6000 von 1998 — mit der Technik, die andere erst im Neufahrzeug bekommen.</h1>
    <p class="lead">
      Niesmann+Bischoff baut den Flair bis heute. Meiner ist der von damals, Stück
      für Stück nachgerüstet: Gas, Diesel, Wasser, Batterien und das Bordnetz melden
      sich von selbst und sagen Bescheid, wenn etwas nicht stimmt. Hier steht, wie
      das gegangen ist — mit dem Kram, den ich selbst gern gefunden hätte, als ich
      angefangen habe: Verkabelung, Fallstricke, Messwerte, fertiger Code.
    </p>
    <img
      class="hero-fahrzeug"
      src="/bilder/flair.png"
      alt="Zeichnung des Wohnmobils Niesmann+Bischoff Flair in Silber, Nachtblau und Gold-Ocker"
      width="1400"
      height="719"
      loading="eager"
    />
  </section>

  <h2>Aktuelle Projekte</h2>
  <ul class="cards">
    {projekte.map((projekt) => (
      <li class="card">
        <p class="meta">
          <span class={`tag status-${projekt.status?.toLowerCase()}`}>{projekt.status}</span>
          {projekt.stand && <span>{projekt.stand}</span>}
        </p>
        <h3><a href={projekt.url}>{projekt.titel}</a></h3>
        <p>{projekt.kurz}</p>
      </li>
    ))}
  </ul>

  <p><a href="/projekte">Alle Projekte ansehen →</a></p>

  <figure class="bild-band">
    <img
      src="/bilder/flair-band.jpg"
      alt="Der Flair 6000 von der Seite auf einem Schotterplatz an der kroatischen Küste, dahinter das Meer"
      width="1500"
      height="789"
      loading="lazy"
    />
  </figure>

  <h2>Kurz notiert</h2>
  <p class="lead">
    Einzelne Erkenntnisse, für die eine ganze Projektseite zu viel wäre.
  </p>
  <ul class="notizen">
    {notizen.map((notiz) => (
      <li>
        <a href={notiz.url}>{notiz.titel}</a>
        <p>{notiz.kurz}</p>
      </li>
    ))}
  </ul>

  <p><a href="/notizen">Alle Notizen ansehen →</a></p>
</Base>
