---
// Layout für einzelne Projektseiten (Markdown)
// Version: 1.3.0
// Historie:
//   1.0.0 (2026-08-18) – Erstanlage
//   1.1.0 (2026-08-18) – Optionale Angaben meta_titel, meta_beschreibung und
//                        bild aus dem Frontmatter für Suchmaschinen und
//                        Vorschaubilder. Fehlen sie, gelten wie bisher
//                        titel und kurz.
//   1.2.0 (2026-08-19) – Strukturierte Daten (schema.org TechArticle), damit
//                        Suchmaschinen und KI-Assistenten Thema, Autor und
//                        Stand der Seite nicht aus dem Fließtext raten müssen
//   1.3.0 (2026-08-24) – Baustellenhinweis kommt aus dem Frontmatter, gilt also
//                        je Seite statt für alle
import Base from './Base.astro';

const { frontmatter } = Astro.props;

const seiteUrl = new URL(Astro.url.pathname, Astro.site).href;

const strukturierteDaten = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: frontmatter.meta_titel ?? frontmatter.titel,
  name: frontmatter.titel,
  description: frontmatter.meta_beschreibung ?? frontmatter.kurz,
  inLanguage: 'de',
  url: seiteUrl,
  mainEntityOfPage: seiteUrl,
  datePublished: frontmatter.stand,
  dateModified: frontmatter.stand,
  keywords: frontmatter.tags?.join(', '),
  image: frontmatter.bild ? new URL(frontmatter.bild, Astro.site).href : undefined,
  author: { '@type': 'Person', name: 'Daniel Großmann', url: 'https://cologneone.de/ueber' },
  publisher: { '@type': 'Person', name: 'Daniel Großmann' },
};
---

<Base
  title={frontmatter.titel}
  metaTitle={frontmatter.meta_titel}
  description={frontmatter.meta_beschreibung ?? frontmatter.kurz}
  bild={frontmatter.bild}
  typ="article"
  baustelle={frontmatter.baustelle === true}
>
  <script
    slot="kopf"
    type="application/ld+json"
    set:html={JSON.stringify(strukturierteDaten)}
  />

  <a class="back" href="/projekte">← Alle Projekte</a>
  <article class="prose">
    <p class="eyebrow">Projekt</p>
    <h1>{frontmatter.titel}</h1>
    <p class="lead">{frontmatter.kurz}</p>
    <p class="meta">
      <span class={`tag status-${frontmatter.status?.toLowerCase()}`}>{frontmatter.status}</span>
      {frontmatter.stand && <span>Stand: {frontmatter.stand}</span>}
      {frontmatter.tags?.map((tag) => <span class="tag">{tag}</span>)}
    </p>
    <hr />
    <slot />
  </article>
</Base>
