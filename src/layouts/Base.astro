---
// Basis-Layout für alle Seiten
// Version: 2.6.0
// Historie:
//   2.3.0 (2026-08-18) — Baustellenhinweis über dem Inhalt
//   2.4.0 (2026-08-18) — Auffindbarkeit: eigener Seitentitel und eigene
//                        Beschreibung je Seite, dazu Vorschaubild und
//                        vollständige Open-Graph-Angaben fürs Teilen in
//                        Foren und Messengern
//   2.5.0 (2026-08-19) — Platz im Kopfbereich für seitenspezifische Angaben
//                        (benannter Slot "kopf"), z. B. strukturierte Daten
//   2.6.0 (2026-08-24) — Der Baustellenhinweis gilt nicht mehr pauschal für die
//                        ganze Seite, sondern nur noch dort, wo wirklich etwas
//                        fehlt. Neuer Bereich "Notizen" in der Navigation.
import '../styles/global.css';

const {
  // Kurzer Titel für die Seite selbst. Bekommt "— cologneone" angehängt.
  title,
  // Vollständiger Titel für <title> und Suchmaschinen, ohne Anhängsel.
  // Damit lässt sich der Seitentitel gezielt auf die Begriffe legen,
  // nach denen jemand tatsächlich sucht.
  metaTitle,
  description = 'Projekte, Basteleien und Notizen von Cologneone.',
  // Pfad zu einem Vorschaubild, z. B. "/bilder/rotarex/cerbo-tanks.png"
  bild,
  typ = 'website',
  // Zeigt den Baustellenhinweis über dem Inhalt. Bewusst nur dort setzen, wo
  // wirklich etwas fehlt — ein Hinweis, der überall steht, wird nicht gelesen.
  baustelle = false,
} = Astro.props;

const seitentitel = metaTitle ?? (title ? `${title} — cologneone` : 'cologneone');
const seitenUrl = new URL(Astro.url.pathname, Astro.site);
const bildUrl = bild ? new URL(bild, Astro.site) : null;

const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';

const navigation = [
  { href: '/', label: 'Start' },
  { href: '/projekte', label: 'Projekte' },
  { href: '/notizen', label: 'Notizen' },
  { href: '/ueber', label: 'Über' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={seitenUrl} />

    <meta property="og:type" content={typ} />
    <meta property="og:site_name" content="cologneone" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={seitenUrl} />
    {bildUrl && <meta property="og:image" content={bildUrl} />}

    <meta name="twitter:card" content={bildUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={seitentitel} />
    <meta name="twitter:description" content={description} />
    {bildUrl && <meta name="twitter:image" content={bildUrl} />}

    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Platz für seitenspezifische Angaben, etwa strukturierte Daten -->
    <slot name="kopf" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-text">cologne<span>one</span></span>
        </a>
        <nav class="main">
          {navigation.map((eintrag) => (
            <a
              href={eintrag.href}
              aria-current={pfad === eintrag.href || (eintrag.href !== '/' && pfad.startsWith(eintrag.href)) ? 'page' : undefined}
            >
              {eintrag.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div class="flair-band" aria-hidden="true"></div>

    {baustelle && (
      <div class="baustelle">
        <div class="wrap">
          <span class="baustelle-schild">Baustelle</span>
          <span>
            Diese Seite entsteht noch. Inhalte sind unvollständig und ändern sich.
          </span>
        </div>
      </div>
    )}

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <div class="flair-band" aria-hidden="true"></div>
    <footer class="site-footer">
      <div class="wrap">
        <div>© {new Date().getFullYear()} cologneone.de</div>
        <div>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </div>
      </div>
    </footer>
  </body>
</html>
