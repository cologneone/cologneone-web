---
// Seitenansicht des Wohnmobils (Alkoven auf Fiat Ducato) als Strichgrafik
// Version: 1.2.0 (2026-08-18) — Alkoven-Unterkante, Scheibe und Markise nachgeschärft
// Farben aus dem Fahrzeugdekor: Creme-Aufbau, Nachtblau, Gold-Ocker, Silber
const { size = 40, class: klasse = '' } = Astro.props;
---

<svg
  class={klasse}
  width={size * 2.7}
  height={size}
  viewBox="0 0 216 80"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Wohnmobil in der Seitenansicht"
>
  <!-- Fahrerhaus -->
  <path d="M150 38 H202 L206 48 V62 H150 Z" fill="#868c94" />

  <!-- Aufbau mit Alkoven als durchgehende Silhouette -->
  <path
    d="M8 62 V26 H134 V13 L196 16 L202 30 V38 H150 V62 Z"
    fill="#f2ede3"
  />
  <path
    d="M8 62 V26 H134 V13 L196 16 L204 30 L206 48 V62 Z"
    fill="none"
    stroke="#1b2a54"
    stroke-width="3.5"
    stroke-linejoin="round"
  />

  <!-- Markise an der Dachkante -->
  <rect x="12" y="27.5" width="118" height="4" rx="2" fill="#c9cdd3" />

  <!-- Fenster im Aufbau -->
  <rect x="24" y="33" width="32" height="12" rx="3" fill="#1b2a54" />
  <rect x="64" y="33" width="24" height="12" rx="3" fill="#1b2a54" />

  <!-- Aufbautür -->
  <rect x="98" y="32" width="26" height="26" rx="3.5" fill="none" stroke="#1b2a54" stroke-width="3" />

  <!-- Alkovenfenster -->
  <rect x="146" y="20" width="34" height="10" rx="3" fill="#1b2a54" />

  <!-- Unterkante des Alkovens -->
  <path d="M150 38 H203" stroke="#1b2a54" stroke-width="3" stroke-linecap="round" />

  <!-- Windschutzscheibe und Spiegel -->
  <path d="M168 40 H197 L201 48 H168 Z" fill="#1b2a54" />
  <rect x="160" y="40" width="5" height="9" rx="2" fill="#1b2a54" />

  <!-- Zierstreifen: Nachtblau, Creme-Fuge, Gold-Ocker -->
  <rect x="9" y="50" width="196" height="2.5" fill="#1b2a54" />
  <rect x="9" y="53" width="196" height="6" fill="#d9a02b" />

  <!-- Räder -->
  <circle cx="52" cy="62" r="9.5" fill="#1b2a54" />
  <circle cx="52" cy="62" r="3.8" fill="#f2ede3" />
  <circle cx="178" cy="62" r="9.5" fill="#1b2a54" />
  <circle cx="178" cy="62" r="3.8" fill="#f2ede3" />
</svg>
