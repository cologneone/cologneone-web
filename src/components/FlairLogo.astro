---
// Seitenansicht des Niesmann+Bischoff Flair (Alkoven auf Fiat Ducato)
// Version: 2.2.0 (2026-08-18) — nach echtem Seitenfoto neu gezeichnet:
//   keilförmiger Alkoven mit Spitze nach vorn, silberner Aufbau,
//   zwei Zierbänder, anthrazitfarbenes Fahrerhaus, Blickrichtung links
const { size = 40, class: klasse = '' } = Astro.props;
---

<svg
  class={klasse}
  width={size * 2.9}
  height={size}
  viewBox="0 0 240 84"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Wohnmobil in der Seitenansicht"
>
  <!-- Fahrerhaus -->
  <path
    d="M22 50 H66 V74 H18 L12 64 L14 54 Z"
    fill="#565c66"
    stroke="#1b2a54"
    stroke-width="3"
    stroke-linejoin="round"
  />

  <!-- Aufbau mit keilförmigem Alkoven -->
  <path
    d="M64 18 H230 V74 H64 V50 H26 L10 34 L30 19 Z"
    fill="#dbe0e5"
    stroke="#1b2a54"
    stroke-width="3.5"
    stroke-linejoin="round"
  />

  <!-- Dachkante mit Markise -->
  <rect x="66" y="14.5" width="164" height="5" rx="2.5" fill="#eceff2" stroke="#1b2a54" stroke-width="2" />

  <!-- Oberes Zierband: Nachtblau, Gold-Ocker -->
  <path d="M20 33 H230" stroke="#1b2a54" stroke-width="2" />
  <path d="M21 37 H230" stroke="#d9a02b" stroke-width="5" />

  <!-- Unteres Zierband -->
  <path d="M66 61 H230" stroke="#1b2a54" stroke-width="2" />
  <path d="M66 65 H230" stroke="#d9a02b" stroke-width="5" />

  <!-- Dunkle Schürze unterhalb der Zierbänder -->
  <path d="M66 71.5 H230" stroke="#494f58" stroke-width="5" />

  <!-- Alkovenfenster -->
  <rect x="30" y="22" width="30" height="8" rx="2.5" fill="#1b2a54" />

  <!-- Aufbaufenster -->
  <rect x="120" y="44" width="62" height="15" rx="3" fill="#1b2a54" />

  <!-- Aufbautür -->
  <rect x="76" y="44" width="24" height="30" rx="3" fill="none" stroke="#1b2a54" stroke-width="2.5" />

  <!-- Seitenscheibe im Fahrerhaus -->
  <path d="M30 52 H60 V60 H25 Z" fill="#1b2a54" />

  <!-- Zierkeil am Fahrerhaus: schmaler Gold-Streifen mit blauer Kante -->
  <path d="M18 71 L35 65 H64" stroke="#d9a02b" stroke-width="5" fill="none" stroke-linejoin="round" />
  <path d="M18 67 L34 61 H64" stroke="#1b2a54" stroke-width="2" fill="none" stroke-linejoin="round" />

  <!-- Räder -->
  <circle cx="48" cy="74" r="10" fill="#1b2a54" />
  <circle cx="48" cy="74" r="4" fill="#dbe0e5" />
  <circle cx="196" cy="74" r="10" fill="#1b2a54" />
  <circle cx="196" cy="74" r="4" fill="#dbe0e5" />
</svg>
